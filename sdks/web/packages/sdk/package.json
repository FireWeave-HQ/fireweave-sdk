{
  "name": "@fireweaveai/web-sdk",
  "version": "2.1.0",
  "description": "Fireweave release-engineering SDK for browsers: control points, target registration, exposures, and health/outcome signals \u2014 with an OpenFeature web provider. Remote-only; holds no secrets.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FireWeave-HQ/fireweave-sdk.git",
    "directory": "sdks/web/packages/sdk"
  },
  "homepage": "https://github.com/FireWeave-HQ/fireweave-sdk/tree/master/sdks/web/packages/sdk#readme",
  "bugs": "https://github.com/FireWeave-HQ/fireweave-sdk/issues",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/web-sdk": {
      "optional": true
    }
  },
  "keywords": [
    "fireweave",
    "release-engineering",
    "progressive-delivery",
    "control-points",
    "feature-flags",
    "openfeature",
    "browser",
    "web"
  ]
}
