{
  "name": "@fireweaveai/sdk",
  "version": "2.1.0",
  "description": "Fireweave release-engineering SDK for server runtimes: control points, target registration, release lifecycle, exposures, and health/outcome signals \u2014 with an OpenFeature provider. Runs on Node, Bun, and Deno.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FireWeave-HQ/fireweave-sdk.git",
    "directory": "sdks/node/packages/sdk"
  },
  "homepage": "https://github.com/FireWeave-HQ/fireweave-sdk/tree/master/sdks/node/packages/sdk#readme",
  "bugs": "https://github.com/FireWeave-HQ/fireweave-sdk/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.22.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    }
  },
  "keywords": [
    "fireweave",
    "release-engineering",
    "progressive-delivery",
    "control-points",
    "feature-flags",
    "openfeature",
    "server",
    "bun",
    "deno"
  ]
}
