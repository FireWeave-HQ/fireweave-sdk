  <artifactId>fireweave-openfeature</artifactId>
  <name>Fireweave OpenFeature provider</name>
  <description>
    dev.openfeature FeatureProvider implementation backed by FireweaveRuntime.
    All resolvers (boolean/string/integer/double/object), initialize/shutdown, error-code
    mapping, targetingKey → distinct_id, reason passthrough.
  </description>

  <dependencies>
    <dependency>
      <groupId>ai.fireweave</groupId>
      <artifactId>fireweave-sdk</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.openfeature</groupId>
      <artifactId>sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
