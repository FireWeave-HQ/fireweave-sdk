{
  "description": "Auth failures never include API keys in errorMessage",
  "tags": [
    "secrets"
  ],
  "given": {
    "providerState": "READY",
    "config": {
      "projectApiKey": "phc_SUPERSECRET0000000000000000001"
    },
    "fault": {
      "mode": "httpStatus",
      "status": 401
    },
    "controlPoints": {}
  },
  "when": {
    "operation": "evaluate",
    "controlPointKey": "fw-sec",
    "flagType": "boolean",
    "defaultValue": false,
    "invocationContext": {
      "targetingKey": "org_01HZXSEC000000000000002"
    }
  },
  "expect": {
    "value": false,
    "variant": null,
    "reason": "ERROR",
    "errorCode": "GENERAL",
    "errorMessage": "authentication failed",
    "errorMessageMustNotContain": [
      "phc_SUPERSECRET",
      "phc_",
      "SUPERSECRET"
    ],
    "controlPointMetadata": {
      "fireweave.errorKind": "Authentication"
    }
  },
  "schemaVersion": 1,
  "id": "sec-secrets-not-in-errors",
  "suite": "security",
  "provisional": false,
  "compatibility": {
    "node": "pass",
    "python": "pass",
    "go": "pass",
    "java": "pass"
  },
  "limitations": {}
}
