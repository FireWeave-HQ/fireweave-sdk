{
  "description": "capabilities.get returns the structured static/runtime capability matrix (spec/capabilities.schema.json; ruling 18) — never a flat capability-string list",
  "tags": [
    "capabilities",
    "matrix"
  ],
  "given": {
    "providerState": "READY",
    "extensions": {
      "releases": true,
      "exposures": true,
      "signals": true,
      "capabilities": true
    }
  },
  "when": {
    "operation": "getCapabilities"
  },
  "expect": {
    "capabilities": {
      "static": {
        "openFeature": {
          "specFloor": "0.8.0",
          "providerName": "fireweave"
        },
        "features": {
          "flags": true,
          "releases": true,
          "exposures": true,
          "signals": true,
          "inMemoryAdapter": true
        }
      },
      "runtime": {
        "backend": "inmemory",
        "lifecycle": "READY"
      }
    },
    "errorCode": null
  },
  "schemaVersion": 1,
  "id": "ext-capabilities-get",
  "suite": "extensions",
  "provisional": false,
  "compatibility": {
    "node": "pass",
    "python": "pass",
    "go": "pass",
    "java": "pass"
  },
  "limitations": {}
}
