{
  "schemaVersion": 1,
  "id": "start-channel-rule",
  "suite": "start",
  "description": "Release channel from a semver-style version: a version containing -rc. is staging; everything else is production",
  "rules": [
    "SP-13"
  ],
  "profile": "any",
  "provisional": true,
  "cases": [
    {
      "name": "release-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "2.4.0"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "rc-is-staging",
      "when": {
        "operation": "channelForVersion",
        "version": "2.4.0-rc.1"
      },
      "expect": {
        "channel": "staging"
      }
    },
    {
      "name": "go-tag-rc-is-staging",
      "when": {
        "operation": "channelForVersion",
        "version": "v2.4.0-rc.12"
      },
      "expect": {
        "channel": "staging"
      }
    },
    {
      "name": "legacy-staging-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "2.4.0-staging.1"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "legacy-go-tag-staging-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "v2.4.0-staging.12"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "other-prerelease-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "2.4.0-beta.1"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "rc-without-iteration-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "2.4.0-rc"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "build-metadata-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "2.4.0+rc.1"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "go-pseudo-of-rc-is-staging",
      "when": {
        "operation": "channelForVersion",
        "version": "v3.0.0-rc.1.0.20261010120000-abcdef123456"
      },
      "expect": {
        "channel": "staging"
      }
    },
    {
      "name": "go-pseudo-of-legacy-staging-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "v3.0.0-staging.1.0.20261010120000-abcdef123456"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "go-pseudo-of-release-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "v3.0.1-0.20261010120000-abcdef123456"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "dev-store-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "3.0.0-dev.20261009.abc1234"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "snapshot-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "2.4.0-SNAPSHOT"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "devel-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": "(devel)"
      },
      "expect": {
        "channel": "production"
      }
    },
    {
      "name": "empty-is-production",
      "when": {
        "operation": "channelForVersion",
        "version": ""
      },
      "expect": {
        "channel": "production"
      }
    }
  ],
  "compatibility": {
    "node": "not-applicable",
    "web": "not-applicable",
    "python": "not-applicable",
    "go": "pass",
    "java": "pass",
    "rust": "pass",
    "swift": "pass",
    "dart": "not-applicable"
  },
  "limitations": {
    "node": "the channel is stamped at release by tools/release/version.sh (covered by tools/release/version.test.sh), not computed at run time; from 3.0.0 the stamp is staging only for an X.Y.Z-rc.N version (-staging.N stopped being a staging spelling at 3.0.0)",
    "web": "the channel is stamped at release by tools/release/version.sh (covered by tools/release/version.test.sh), not computed at run time; from 3.0.0 the stamp is staging only for an X.Y.Z-rc.N version (-staging.N stopped being a staging spelling at 3.0.0)",
    "python": "python staging versions are PEP 440 pre-releases; see start-channel-rule-pep440",
    "dart": "the channel is stamped at release by tools/release/version.sh (covered by tools/release/version.test.sh), not computed at run time; from 3.0.0 the stamp is staging only for an X.Y.Z-rc.N version (-staging.N stopped being a staging spelling at 3.0.0)"
  }
}
