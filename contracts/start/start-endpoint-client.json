{
  "schemaVersion": 1,
  "id": "start-endpoint-client",
  "suite": "start",
  "description": "Client endpoints from build values",
  "rules": [
    "SP-14",
    "SP-15"
  ],
  "profile": "client",
  "provisional": true,
  "cases": [
    {
      "name": "override-scopes-the-allowlist",
      "when": {
        "operation": "resolve",
        "build": {
          "FIREWEAVE_BROWSER_KEY": "fw_public_contracttest01",
          "FIREWEAVE_URL": "https://fw.example.com/"
        }
      },
      "expect": {
        "url": "https://fw.example.com",
        "urlSource": "FIREWEAVE_URL",
        "allowedHosts": [
          "fw.example.com",
          "localhost",
          "127.0.0.1",
          "::1"
        ]
      }
    },
    {
      "name": "http-on-localhost-is-allowed",
      "when": {
        "operation": "resolve",
        "build": {
          "FIREWEAVE_BROWSER_KEY": "fw_public_contracttest01",
          "FIREWEAVE_URL": "http://localhost:3001"
        }
      },
      "expect": {
        "url": "http://localhost:3001"
      }
    },
    {
      "name": "http-off-loopback-fails",
      "when": {
        "operation": "resolve",
        "build": {
          "FIREWEAVE_BROWSER_KEY": "fw_public_contracttest01",
          "FIREWEAVE_URL": "http://fw.example.com"
        }
      },
      "expect": {
        "error": {
          "kind": "Configuration",
          "mentions": [
            "FIREWEAVE_URL"
          ]
        }
      }
    },
    {
      "name": "same-origin-path-is-kept",
      "when": {
        "operation": "resolve",
        "build": {
          "FIREWEAVE_BROWSER_KEY": "fw_public_contracttest01",
          "FIREWEAVE_URL": "/fw"
        }
      },
      "expect": {
        "url": "/fw",
        "urlSource": "FIREWEAVE_URL"
      },
      "appliesTo": [
        "web"
      ]
    },
    {
      "name": "protocol-relative-url-fails",
      "when": {
        "operation": "resolve",
        "build": {
          "FIREWEAVE_BROWSER_KEY": "fw_public_contracttest01",
          "FIREWEAVE_URL": "//cdn.example.com"
        }
      },
      "expect": {
        "error": {
          "kind": "Configuration",
          "mentions": [
            "FIREWEAVE_URL"
          ]
        }
      },
      "appliesTo": [
        "web"
      ]
    }
  ],
  "compatibility": {
    "node": "not-applicable",
    "web": "pass",
    "python": "not-applicable",
    "go": "not-applicable",
    "java": "not-applicable",
    "rust": "not-applicable",
    "swift": "pass",
    "dart": "pass"
  },
  "limitations": {
    "node": "client-profile fixture; this language has only the server profile",
    "python": "client-profile fixture; this language has only the server profile",
    "go": "client-profile fixture; this language has only the server profile",
    "java": "client-profile fixture; this language has only the server profile",
    "rust": "client-profile fixture; this language has only the server profile"
  }
}
