{
  "schemaVersion": 1,
  "description": "Fireweave canonical error taxonomy mapped to OpenFeature error codes",
  "rules": {
    "defaultsDoNotThrow": true,
    "noSecretsInMessages": true,
    "secretPatterns": [
      "phc_",
      "phx_",
      "phs_",
      "Bearer ",
      "FW_PROJECT_API_KEY"
    ],
    "controlPointMetadataErrorKindKey": "fireweave.errorKind",
    "redaction": {
      "description": "How every SDK scrubs text before it reaches an error message, a log line or a signal. Applied in this order: bearer tokens, URL userinfo, named assignments, then key-shaped values. A variable NAME is never redacted on its own; only its value is. Each SDK's redactor MUST turn every vector's `in` into exactly its `out` (start-profile spec SP-26).",
      "placeholder": "[REDACTED]",
      "bearer": "the token after `Bearer ` ([A-Za-z0-9._~+/=-]+) becomes the placeholder; the word `Bearer` stays",
      "urlUserinfo": "in `scheme://userinfo@host`, the userinfo becomes the placeholder",
      "assignmentNames": [
        "FIREWEAVE_KEY",
        "FIREWEAVE_BROWSER_KEY",
        "FW_PROJECT_API_KEY"
      ],
      "assignment": "`NAME=value`, `NAME: value`, `NAME = \"value\"` or `NAME='value'`: the value (up to whitespace, a quote, a comma or a semicolon) becomes the placeholder; the name, separator and quotes stay",
      "valuePrefixes": [
        "project-api-key_",
        "fw_public_",
        "fw_ingest_pub_",
        "fw_org_",
        "cli_at_",
        "phc_",
        "phx_",
        "phs_"
      ],
      "value": "a token that starts with a value prefix followed by one or more of [A-Za-z0-9_-] becomes the placeholder; a prefix followed by anything else (for example the ellipsis in `project-api-key_…`) is prose and stays",
      "vectors": [
        {
          "in": "key phc_abc123XYZ rejected",
          "out": "key [REDACTED] rejected"
        },
        {
          "in": "using project-api-key_9f8e7d6c now",
          "out": "using [REDACTED] now"
        },
        {
          "in": "browser key fw_public_ab12cd34 refused",
          "out": "browser key [REDACTED] refused"
        },
        {
          "in": "legacy fw_ingest_pub_abcd1234 key",
          "out": "legacy [REDACTED] key"
        },
        {
          "in": "org token fw_org_abcd1234 here",
          "out": "org token [REDACTED] here"
        },
        {
          "in": "cli token cli_at_abcd1234 expired",
          "out": "cli token [REDACTED] expired"
        },
        {
          "in": "FIREWEAVE_KEY=project-api-key_abc123",
          "out": "FIREWEAVE_KEY=[REDACTED]"
        },
        {
          "in": "FIREWEAVE_KEY=plainsecret123 was set",
          "out": "FIREWEAVE_KEY=[REDACTED] was set"
        },
        {
          "in": "FW_PROJECT_API_KEY: abc123def",
          "out": "FW_PROJECT_API_KEY: [REDACTED]"
        },
        {
          "in": "FIREWEAVE_BROWSER_KEY=\"fw_public_x1y2z3\"",
          "out": "FIREWEAVE_BROWSER_KEY=\"[REDACTED]\""
        },
        {
          "in": "header Bearer eyJhbGciOi.payload.sig sent",
          "out": "header Bearer [REDACTED] sent"
        },
        {
          "in": "fetch https://user:pa55word@fw.example.com/v1/flags failed",
          "out": "fetch https://[REDACTED]@fw.example.com/v1/flags failed"
        },
        {
          "in": "set FIREWEAVE_KEY in the environment",
          "out": "set FIREWEAVE_KEY in the environment"
        },
        {
          "in": "FW_PROJECT_API_KEY is a legacy name",
          "out": "FW_PROJECT_API_KEY is a legacy name"
        },
        {
          "in": "a server key (project-api-key_…) is required",
          "out": "a server key (project-api-key_…) is required"
        },
        {
          "in": "no secret here",
          "out": "no secret here"
        }
      ]
    }
  },
  "errors": [
    {
      "kind": "NotReady",
      "openFeatureErrorCode": "PROVIDER_NOT_READY",
      "retryable": true,
      "class": "transient",
      "defaultMessage": "provider not ready",
      "description": "Evaluation attempted before successful initialization or while cold-start gate is active"
    },
    {
      "kind": "ControlPointNotFound",
      "openFeatureErrorCode": "FLAG_NOT_FOUND",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "flag not found",
      "description": "Control point absent from evaluation snapshot or definitions; also used when quotaLimited yields empty flags"
    },
    {
      "kind": "TypeMismatch",
      "openFeatureErrorCode": "TYPE_MISMATCH",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "flag type mismatch",
      "description": "Requested typed getter does not match the stored value type"
    },
    {
      "kind": "InvalidContext",
      "openFeatureErrorCode": "INVALID_CONTEXT",
      "openFeatureErrorCodeAlternates": [
        "TARGETING_KEY_MISSING"
      ],
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "invalid evaluation context",
      "description": "Context failed validation: missing targeting key, reserved key misuse, or size/depth/count bounds"
    },
    {
      "kind": "Authentication",
      "openFeatureErrorCode": "GENERAL",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "authentication failed",
      "description": "HTTP 401 or invalid project/secret API key; message must not echo the key"
    },
    {
      "kind": "Authorization",
      "openFeatureErrorCode": "GENERAL",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "authorization failed",
      "description": "HTTP 403 or key lacks required permissions"
    },
    {
      "kind": "RateLimited",
      "openFeatureErrorCode": "GENERAL",
      "retryable": true,
      "class": "transient",
      "defaultMessage": "rate limited",
      "description": "HTTP 429 from the backend; evaluations still return defaults. Quota-limited responses resolve as ControlPointNotFound with fireweave.quotaLimited metadata"
    },
    {
      "kind": "Timeout",
      "openFeatureErrorCode": "GENERAL",
      "retryable": true,
      "class": "transient",
      "defaultMessage": "request timed out",
      "description": "Evaluate request or initialization deadline exceeded"
    },
    {
      "kind": "Network",
      "openFeatureErrorCode": "GENERAL",
      "retryable": true,
      "class": "transient",
      "defaultMessage": "network error",
      "description": "DNS, connection, reset, or TLS failure talking to backend"
    },
    {
      "kind": "BackendUnavailable",
      "openFeatureErrorCode": "GENERAL",
      "retryable": true,
      "class": "transient",
      "defaultMessage": "backend unavailable",
      "description": "HTTP 5xx or upstream unavailable"
    },
    {
      "kind": "MalformedResponse",
      "openFeatureErrorCode": "PARSE_ERROR",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "malformed backend response",
      "description": "Non-JSON or schema-invalid /flags or definitions response body"
    },
    {
      "kind": "UnsupportedCapability",
      "openFeatureErrorCode": "GENERAL",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "unsupported capability",
      "description": "Requested Fireweave extension/capability is not available in this SDK"
    },
    {
      "kind": "Configuration",
      "openFeatureErrorCode": "PROVIDER_FATAL",
      "openFeatureErrorCodeAlternates": [
        "GENERAL"
      ],
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "invalid configuration",
      "description": "Invalid host, missing required config, or mutually exclusive options; init-fatal uses PROVIDER_FATAL"
    },
    {
      "kind": "AlreadyClosed",
      "openFeatureErrorCode": "PROVIDER_NOT_READY",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "provider already closed",
      "description": "Operation invoked after shutdown/close; Fireweave kind preserved in controlPointMetadata fireweave.errorKind"
    },
    {
      "kind": "Internal",
      "openFeatureErrorCode": "GENERAL",
      "retryable": false,
      "class": "permanent",
      "defaultMessage": "internal error",
      "description": "Unexpected invariant violation; no secret or PII in message"
    }
  ]
}
