{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireweave.ai/spec/0.1.0/remote-capture.schema.json",
  "title": "FireweaveRemoteCapture",
  "description": "Vendor-neutral wire protocol for POST /v1/capture (ADR-0005). Auth: Authorization: Bearer <Fireweave project/runtime key>. Batches exposures, signals, and generic events. No PostHog field names — fw-server maps to the connected provider.",
  "type": "object",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string", "maxLength": 16384 },
        { "type": "number" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" },
          "maxItems": 128
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" },
          "maxProperties": 128
        }
      ]
    },
    "captureEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetingKey"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["exposure", "signal", "event"],
          "description": "exposure = flag impression; signal = Fireweave telemetry; event = generic analytics."
        },
        "targetingKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Required for type=signal|event. Ignored for exposure (server maps to provider exposure event)."
        },
        "flagKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": { "$ref": "#/$defs/jsonValue" },
        "variant": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "rolloutId": { "type": "string", "maxLength": 128 },
        "changeId": { "type": "string", "maxLength": 128 },
        "stampId": { "type": "string", "maxLength": 128 },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" },
          "maxProperties": 64
        }
      }
    },
    "captureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/captureEvent" }
        }
      }
    },
    "captureResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of events accepted for forwarding."
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/captureRequest" },
    { "$ref": "#/$defs/captureResponse" }
  ]
}
