{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireweave.ai/spec/0.1.0/evaluation-context.schema.json",
  "title": "FireweaveEvaluationContext",
  "description": "Canonical evaluation context for Fireweave SDKs. Maps to OpenFeature EvaluationContext; targetingKey is required for evaluation and becomes PostHog distinct_id. SDKs never auto-generate anonymous IDs per evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "targetingKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable cohort / identity key (e.g. orgId, userId). REQUIRED at evaluation time. Maps 1:1 to PostHog distinct_id. Never auto-generated by the SDK."
    },
    "attributes": {
      "type": "object",
      "description": "OpenFeature context attributes. Non-reserved keys map to PostHog person_properties. Values are JSON-compatible (boolean, string, number, datetime-as-string, or nested structure).",
      "additionalProperties": {
        "$ref": "#/$defs/attributeValue"
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "not": {
          "pattern": "^fireweave\\."
        }
      },
      "maxProperties": 128
    },
    "reserved": {
      "type": "object",
      "description": "Fireweave-reserved context extensions. Prefer top-level reserved object in canonical JSON; language SDKs may flatten as fireweave.* keys in OF attributes.",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "object",
          "description": "Map of group type → group key (PostHog groups).",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxProperties": 32
        },
        "groupProperties": {
          "type": "object",
          "description": "Map of group type → property map (PostHog group_properties).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/attributeValue"
            },
            "maxProperties": 64
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxProperties": 32
        },
        "evaluationContexts": {
          "type": "array",
          "description": "PostHog evaluation context tags (evaluation_contexts).",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "attributeValue": {
      "description": "JSON-compatible attribute value with nesting bounds.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string", "maxLength": 4096 },
        { "type": "number" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/attributeValue" },
          "maxItems": 64
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/attributeValue" },
          "maxProperties": 64
        }
      ]
    },
    "mergePrecedence": {
      "description": "Documentary: OpenFeature merge order (SDK-owned). Later wins on key conflicts.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "api",
          "transaction",
          "client",
          "invocation",
          "beforeHook"
        ]
      },
      "readOnly": true,
      "default": [
        "api",
        "transaction",
        "client",
        "invocation",
        "beforeHook"
      ]
    },
    "bounds": {
      "description": "Hard limits for implementations and fixtures.",
      "type": "object",
      "properties": {
        "maxDepth": {
          "type": "integer",
          "const": 6,
          "description": "Maximum nesting depth for attributes / reserved structures (root = 1)."
        },
        "maxSerializedBytes": {
          "type": "integer",
          "const": 65536,
          "description": "Approximate max UTF-8 JSON size for a single evaluation context."
        },
        "maxAttributeKeys": { "type": "integer", "const": 128 },
        "maxStringLength": { "type": "integer", "const": 4096 }
      }
    },
    "reservedKeys": {
      "description": "Keys that MUST NOT appear as ordinary person attribute names when flattened into OF context. Flattened form uses fireweave. prefix.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fireweave.groups",
          "fireweave.groupProperties",
          "fireweave.evaluationContexts",
          "targetingKey"
        ]
      }
    },
    "identityRules": {
      "description": "Identity policy for Agent E fixtures and implementations.",
      "type": "object",
      "properties": {
        "autoGenerateAnonymousPerEvaluation": {
          "type": "boolean",
          "const": false
        },
        "missingTargetingKeyError": {
          "type": "string",
          "const": "TARGETING_KEY_MISSING"
        },
        "mapsToPostHog": {
          "type": "string",
          "const": "distinct_id"
        }
      }
    },
    "piiAndRedaction": {
      "description": "PII handling guidance encoded for tooling.",
      "type": "object",
      "properties": {
        "contextMayContainPii": {
          "type": "boolean",
          "const": true,
          "description": "Callers may place emails/names in attributes; SDK passes through to backend as person properties."
        },
        "neverLogKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "apiKey",
              "secretKey",
              "personalApiKey",
              "FW_PROJECT_API_KEY",
              "POSTHOG_PROJECT_API_KEY",
              "Authorization"
            ]
          }
        },
        "redactPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["phc_", "phs_", "phx_", "Bearer "]
          },
          "description": "Prefix patterns to redact from Fireweave logs and error messages."
        },
        "defaultLogFullContext": {
          "type": "boolean",
          "const": false,
          "description": "Implementations MUST NOT dump full evaluation context at info/default log levels."
        }
      }
    }
  },
  "examples": [
    {
      "targetingKey": "org_01HZXEXAMPLE",
      "attributes": {
        "plan": "enterprise",
        "seatCount": 42
      },
      "reserved": {
        "groups": { "organization": "org_01HZXEXAMPLE" },
        "groupProperties": {
          "organization": { "tier": "enterprise" }
        },
        "evaluationContexts": ["production"]
      }
    }
  ]
}
